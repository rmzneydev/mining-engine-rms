# PostgreSQL superuser (used by the official postgres image).
# Development values only: replace them outside local development.
POSTGRES_DB=postgres
POSTGRES_USER=mining_user
POSTGRES_PASSWORD=mining_dev_password

# Logical databases and technical users created by database/init.sh.
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_dev_password

BUSINESS_DB_NAME=business_db
BUSINESS_DB_USER=business_user
BUSINESS_DB_PASSWORD=business_dev_password

# Shared HS256 secret. It must be at least 32 bytes and identical in both services.
JWT_SECRET=dev_secret_change_this_to_a_long_random_value_123456789
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=123456

# Frontend API URLs (resolved at build time).
VITE_AUTH_API_URL=http://localhost:3001
VITE_BUSINESS_API_URL=http://localhost:8002
