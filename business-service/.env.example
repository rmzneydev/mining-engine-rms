DATABASE_URL=postgresql+psycopg://business_user:business_dev_password@localhost:5432/business_db
# Shared HS256 secret. Must match auth-service and be at least 32 bytes.
JWT_SECRET=dev_secret_change_this_to_a_long_random_value_123456789
JWT_ISSUER=auth-service
JWT_AUDIENCE=business-service
# Set to true and run `python -m app.seed` to load demo data into an empty database.
SEED_DEMO_DATA=false
